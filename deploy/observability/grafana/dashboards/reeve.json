    {
      "id": 7,
      "type": "row",
      "title": "Jobs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Jobs finished per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(reeve_jobs_succeeded_total[1m])) * 60",
          "legendFormat": "succeeded"
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(reeve_jobs_failed_total[1m])) * 60",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(reeve_jobs_retried_total[1m])) * 60",
          "legendFormat": "retried"
        },
        {
          "refId": "D",
          "expr": "sum(rate(reeve_jobs_submitted_total[1m])) * 60",
          "legendFormat": "submitted"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Execution time by job type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, job_type) (rate(reeve_job_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{job_type}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(reeve_job_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{job_type}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
