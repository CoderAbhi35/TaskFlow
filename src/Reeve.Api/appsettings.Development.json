{
  "ConnectionStrings": {
    "Reeve": "Host=localhost;Port=5432;Database=reeve;Username=reeve;Password=reeve"
  },
  "Auth": {
    "Issuer": "reeve-dev",
    "Audience": "reeve-api",
    "SigningKey": "local-development-only-signing-key-do-not-use-elsewhere",
    "TokenLifetimeMinutes": 480,
    "DevIssuer": {
      "Enabled": true,
      "Users": [
        {
          "Username": "viewer",
          "Password": "viewer",
          "Roles": [
            "viewer"
          ]
        },
        {
          "Username": "operator",
          "Password": "operator",
          "Roles": [
            "operator"
          ]
        },
        {
          "Username": "admin",
          "Password": "admin",
          "Roles": [
            "admin"
          ]
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  }
}
